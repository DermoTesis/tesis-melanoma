rules_version = '2';

// Dermavía: la app nunca lee ni escribe Firestore directamente. Todo pasa por la API REST en
// Cloud Run, que usa su cuenta de servicio y no está sujeta a estas reglas. Se aplican a las dos
// bases: (default) y validaciones (solo inserción desde el backend).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
